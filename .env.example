# ==============================================================================
# orcust-spine Configuration Template
# Copy this file to .env and adjust paths for your local setup:
#   copy .env.example .env (Windows: copy / Linux: cp)
# ==============================================================================

# Path to CounterSide Data\StreamingAssets directory on your machine
CS_STREAMING_ASSETS_DIR=D:\Game\CounterSide\Game\CounterSide\Data\StreamingAssets

# Default output directory for extracted Spine assets (relative to repo root or absolute)
OUTPUT_DIR=outputs

# Path to see-through repo clone (github.com/shitagaki-lab/see-through)
# Used for layer decomposition in the image-to-spine pipeline
SEE_THROUGH_DIR=D:\see-through
